rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    // Public website can read published news and events.
    match /news/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /events/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin profile can be read by its owner; clients cannot grant admin access.
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
